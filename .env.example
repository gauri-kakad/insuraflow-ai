# ==========================================
# InsuraFlow AI - Environment Configuration
# ==========================================

# Application Settings
APP_NAME="InsuraFlow AI"
APP_ENV="development"
DEBUG=true
HOST="0.0.0.0"
PORT=8000

# Security & JWT
# Generate a strong secret key in production: openssl rand -hex 32
JWT_SECRET_KEY="replace-with-secure-random-secret-key-for-production"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Origins (Comma-separated)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# MongoDB Database Configuration
MONGODB_URI="mongodb://localhost:27017"
MONGODB_DB_NAME="insuraflow_ai"

# Google Gemini API Configuration
# Obtain from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# Demonstration Mode
# If true, allows deterministic offline workflow demonstration when GEMINI_API_KEY is not configured.
# Note: Deterministic Demo Mode is explicitly labeled in UI and API outputs and never masquerades as live Gemini AI.
ENABLE_DEMO_MODE=true

# File Upload Settings
UPLOAD_DIR="uploads"
MAX_UPLOAD_SIZE_MB=10
TESSERACT_CMD=""
